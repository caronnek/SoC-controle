library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity byte_swap is
    port (
        clk           : in  std_logic;
        reset_n       : in  std_logic;

        -- Interface Avalon-MM Slave
        avs_address   : in  std_logic;                     -- 0 = écriture, 1 = lecture
        avs_write     : in  std_logic;
        avs_writedata : in  std_logic_vector(31 downto 0);
        avs_read      : in  std_logic;
        avs_readdata  : out std_logic_vector(31 downto 0)
    );
end entity byte_swap;


architecture rtl of byte_swap is

    signal data_in  : std_logic_vector(31 downto 0) := (others => '0');
    signal data_out : std_logic_vector(31 downto 0);

begin

    -- Capture de la donnée écrite par le NIOS
    process(clk, reset_n)
    begin
        if reset_n = '0' then
            data_in <= (others => '0');
        elsif rising_edge(clk) then
            if avs_write = '1' and avs_address = '0' then
                data_in <= avs_writedata;
            end if;
        end if;
    end process;

    -- Logique combinatoire : inversion complète des octets
    -- [Octet3|Octet2|Octet1|Octet0] → [Octet0|Octet1|Octet2|Octet3]
    data_out <= data_in(7  downto  0) &
                data_in(15 downto  8) &
                data_in(23 downto 16) &
                data_in(31 downto 24);

    -- Retour du résultat vers le NIOS
    process(clk)
    begin
        if rising_edge(clk) then
            if avs_read = '1' and avs_address = '1' then
                avs_readdata <= data_out;
            end if;
        end if;
    end process;

end architecture rtl;